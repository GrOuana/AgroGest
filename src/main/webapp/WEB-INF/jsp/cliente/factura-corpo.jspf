<%-- Corpo da factura, partilhado pela página normal e pela versão de impressão. Espera ${venda}. --%>
<article class="factura">
  <header class="factura-topo">
    <div class="factura-emitente">
      <img src="${ctx}/img/logo.svg" alt="" width="48" height="48">
      <div>
        <strong>AgroGest</strong><br>
        Produção e comércio agrícola<br>
        Nampula, Moçambique
      </div>
    </div>
    <div class="factura-numero">
      <span>FACTURA</span>
      <strong><c:out value="${venda.numeroFactura}"/></strong>
      <small>${f:dataHora(venda.data)}</small>
    </div>
  </header>

  <section class="factura-cliente">
    <h2>Cliente</h2>
    <p>
      <strong><c:out value="${venda.clienteNome}"/></strong><br>
      <c:out value="${venda.clienteEndereco}"/><br>
      Tel.: <c:out value="${venda.clienteTelefone}"/> · <c:out value="${venda.clienteEmail}"/>
    </p>
  </section>

  <table class="tabela factura-itens">
    <thead>
      <tr><th>Produto</th><th class="num">Quantidade</th><th class="num">Preço unit.</th><th class="num">Subtotal</th></tr>
    </thead>
    <tbody>
      <c:forEach var="i" items="${venda.itens}">
        <tr>
          <td><c:out value="${i.produtoNome}"/></td>
          <td class="num">${i.quantidade} <c:out value="${i.unidade}"/></td>
          <td class="num">${f:mt(i.precoUnit)}</td>
          <td class="num">${f:mt(i.subtotal)}</td>
        </tr>
      </c:forEach>
    </tbody>
    <tfoot>
      <tr><th colspan="3" class="num">Subtotal</th><td class="num">${f:mt(venda.subtotal)}</td></tr>
      <tr><th colspan="3" class="num">IVA (16%)</th><td class="num">${f:mt(venda.iva)}</td></tr>
      <tr class="linha-total"><th colspan="3" class="num">Total</th><td class="num">${f:mt(venda.total)}</td></tr>
    </tfoot>
  </table>

  <p class="factura-nota">Preços em Meticais (MT). IVA à taxa de 16%. Obrigado pela sua preferência.</p>
</article>
