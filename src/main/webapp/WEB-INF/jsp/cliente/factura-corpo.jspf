<%-- Corpo da factura, partilhado pela página normal e pela versão de impressão. Espera ${venda}. --%>
<article class="invoice" aria-labelledby="factura-numero">
  <header class="invoice__header">
    <div class="invoice__issuer">
      <img class="invoice__logo" src="${ctx}/img/logo.svg" alt="" width="48" height="48">
      <address class="invoice__issuer-text">
        <strong class="invoice__issuer-name">AgroGest</strong>
        Produção e comércio agrícola<br>
        Nampula, Moçambique
      </address>
    </div>
    <div class="invoice__number">
      <span class="invoice__number-label">FACTURA</span>
      <h1 class="invoice__number-value" id="factura-numero"><c:out value="${venda.numeroFactura}"/></h1>
      <time class="invoice__date">${f:dataHora(venda.data)}</time>
    </div>
  </header>

  <section aria-labelledby="factura-cliente">
    <h2 class="invoice__section-title" id="factura-cliente">Cliente</h2>
    <address class="invoice__customer">
      <strong class="invoice__customer-name"><c:out value="${venda.clienteNome}"/></strong>
      <c:out value="${venda.clienteEndereco}"/><br>
      Tel.: ${fn:escapeXml(f:telefone(venda.clienteTelefone))} · <c:out value="${venda.clienteEmail}"/>
    </address>
  </section>

  <div class="table-wrap">
    <table class="table">
      <caption class="visually-hidden">Produtos da factura <c:out value="${venda.numeroFactura}"/></caption>
      <thead>
        <tr>
          <th scope="col" class="table__th">Produto</th>
          <th scope="col" class="table__th table__th--num">Quantidade</th>
          <th scope="col" class="table__th table__th--num">Preço unit.</th>
          <th scope="col" class="table__th table__th--num">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <c:forEach var="i" items="${venda.itens}">
          <tr class="table__row">
            <th scope="row" class="table__td"><c:out value="${i.produtoNome}"/></th>
            <td class="table__td table__td--num">${i.quantidade} <c:out value="${i.unidade}"/></td>
            <td class="table__td table__td--num">${f:mt(i.precoUnit)}</td>
            <td class="table__td table__td--num">${f:mt(i.subtotal)}</td>
          </tr>
        </c:forEach>
      </tbody>
      <tfoot>
        <tr class="table__row table__row--foot"><th scope="row" colspan="3" class="table__th table__th--num">Subtotal</th><td class="table__td table__td--num">${f:mt(venda.subtotal)}</td></tr>
        <tr class="table__row table__row--foot"><th scope="row" colspan="3" class="table__th table__th--num">IVA (16%)</th><td class="table__td table__td--num">${f:mt(venda.iva)}</td></tr>
        <tr class="table__row table__row--foot table__row--total"><th scope="row" colspan="3" class="table__th table__th--num">Total</th><td class="table__td table__td--num">${f:mt(venda.total)}</td></tr>
      </tfoot>
    </table>
  </div>

  <p class="invoice__note">Preços em Meticais (MT). IVA à taxa de 16%. Obrigado pela sua preferência.</p>
</article>
